{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://phpdup.local/testsets/schema/manifest.schema.json",
    "title": "manifest.json",
    "$comment": "Generated global index of the corpus (plan_samples.md §7.3). Built by gen/manifest.php.",
    "type": "object",
    "additionalProperties": false,
    "required": ["schema_version", "generated_at", "totals", "corpus_stats", "levels"],
    "properties": {
        "schema_version": {
            "type": "integer",
            "const": 1
        },
        "generated_at": {
            "$comment": "Free-form provenance marker (a git commit ref when known, else an ISO date or 'uncommitted').",
            "type": "string"
        },
        "totals": {
            "type": "object",
            "additionalProperties": false,
            "required": ["levels", "families", "sets", "files", "clusters"],
            "properties": {
                "levels": {"type": "integer", "minimum": 0},
                "families": {"type": "integer", "minimum": 0},
                "sets": {"type": "integer", "minimum": 0},
                "files": {"type": "integer", "minimum": 0},
                "clusters": {"type": "integer", "minimum": 0}
            }
        },
        "corpus_stats": {
            "type": "object",
            "additionalProperties": false,
            "required": ["total_php_files", "total_sloc", "total_duplicate_regions", "distractor_files", "clean_files"],
            "properties": {
                "total_php_files": {"type": "integer", "minimum": 0},
                "total_sloc": {"type": "integer", "minimum": 0},
                "total_duplicate_regions": {"type": "integer", "minimum": 0},
                "distractor_files": {"type": "integer", "minimum": 0},
                "clean_files": {"type": "integer", "minimum": 0}
            }
        },
        "levels": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["level", "dir", "title", "families"],
                "properties": {
                    "level": {"type": "integer", "minimum": 0, "maximum": 10},
                    "dir": {"type": "string"},
                    "title": {"type": "string"},
                    "families": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": ["family", "interference_codes", "sets"],
                            "properties": {
                                "family": {"type": "string"},
                                "interference_codes": {
                                    "type": "array",
                                    "items": {"type": "string"}
                                },
                                "sets": {
                                    "type": "array",
                                    "items": {
                                        "type": "object",
                                        "additionalProperties": false,
                                        "required": ["set_id", "dir", "clusters", "files", "difficulty"],
                                        "properties": {
                                            "set_id": {"type": "string"},
                                            "dir": {"type": "string"},
                                            "clusters": {"type": "integer", "minimum": 0},
                                            "files": {"type": "integer", "minimum": 0},
                                            "difficulty": {"type": "integer", "minimum": 0, "maximum": 100}
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
