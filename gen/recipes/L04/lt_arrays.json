                {"file": "FullyModifiedCalc.php", "namespace": "Acme\\Billing\\FullyModified", "class": "FullyModifiedCalc", "scaffold": "method_gamma", "group": "A", "pristine": false, "transforms": [{"code": "LT-03", "params": {"replacements": [{"find": "'items'", "replace": "'itemCount'"}, {"find": "'subtotal'", "replace": "'sub_total'"}]}}]}
