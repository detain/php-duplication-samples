        {
            "set_id": "L07-api_data_shape-001",
            "title": "Authorization: associative array vs stdClass DTO",
            "description": "The same authorization decision expressed in two genuinely different data-shape idioms: carrier A uses associative arrays throughout; carrier B uses stdClass DTOs for role and grant checking. Both compute identical authorization decisions for all input combinations.",
            "seed": "access_guard",
            "mount": "method",
            "clone_symbol": "authorize",
            "granularity": "method",
            "clone_type": "type-4",
            "normalized_by": [
                "whitespace",
                "comments",
                "identifiers",
                "literals",
                "controlflow"
            ],
            "rng_seed": 107701,
            "notes": "Set 001 of 5. API-07 (api_data_shape) variant uses stdClass DTOs instead of associative arrays for structured data. The array vs object data-shape difference means token-based and AST-based detectors will struggle to find shared token/AST sequences.",
            "detection_expectation": {
                "text_based": false,
                "token_based": true,
                "ast_based": true,
                "metric_based": false,
                "semantic": true
            },
            "role_composition": {"carrier": 2, "distractor": 2, "clean": 1},
            "requires": [
                "api_abstraction",
                "ast_canonicalization"
            ],
            "carriers": [
                {
                    "file": "AccessControlStandard.php",
                    "namespace": "Acme\\Security\\Access",
                    "class": "AccessControlStandard",
                    "scaffold": "method_alpha",
                    "group": "A",
                    "pristine": true,
                    "transforms": []
                },
                {
                    "file": "AccessControlDataShape.php",
                    "namespace": "Acme\\Security\\Access",
                    "class": "AccessControlDataShape",
                    "scaffold": "method_beta",
                    "group": "A",
                    "pristine": false,
                    "variant": "api_data_shape",
                    "transforms": [
                        {
                            "code": "API-07",
                            "variant": "api_data_shape"
                        }
                    ]
                }
            ],
            "distractors": [
                {
                    "file": "RoleHierarchyChecker.php",
                    "namespace": "Acme\\Security\\Auth",
                    "class": "RoleHierarchyChecker",
                    "source": "nearmiss_access",
                    "reason": "near-miss: same authorization domain vocabulary but computes hierarchical role inheritance"
                },
                {
                    "file": "PayrollAccessLogger.php",
                    "namespace": "Acme\\Security\\Audit",
                    "class": "PayrollAccessLogger",
                    "source": "nearmiss_csv",
                    "reason": "near-miss: same authorization vocabulary but logs access attempts to payroll systems — a different concern (audit logging) not authorization decisions"
                }
            ],
            "cleans": [
                {
                    "file": "SessionValidator.php",
