        {
            "set_id": "L07-api_table_driven-001",
            "title": "Authorization: if/else chain vs lookup array",
            "description": "The same authorization decision expressed in two genuinely different idioms: carrier A uses if/else-if guard clauses; carrier B uses a lookup array (array_flip + isset) for role and grant checks. Both compute identical authorization decisions for all input combinations.",
            "seed": "access_guard",
            "mount": "method",
            "clone_symbol": "authorize",
            "granularity": "method",
            "clone_type": "type-4",
            "normalized_by": [
                "whitespace",
                "comments",
                "identifiers",
                "literals",
                "controlflow"
            ],
            "rng_seed": 107501,
            "notes": "Set 001 of 5. API-05 (api_table_driven) variant uses lookup array (array_flip + isset) instead of if/else-if chain for role and grant checks. Both carriers compute mathematically equivalent authorization decisions (verified by equivalence_test.php). The lookup-array vs explicit-condition difference means token-based detectors will struggle to find shared token sequences beyond basic structure.",
            "detection_expectation": {
                "text_based": false,
                "token_based": true,
                "ast_based": true,
                "metric_based": false,
                "semantic": true
            },
            "role_composition": {"carrier": 2, "distractor": 2, "clean": 1},
            "requires": [
                "api_abstraction",
                "ast_canonicalization"
            ],
            "carriers": [
                {
                    "file": "AccessControlStandard.php",
                    "namespace": "Acme\\Security\\Access",
                    "class": "AccessControlStandard",
                    "scaffold": "method_alpha",
                    "group": "A",
                    "pristine": true,
                    "transforms": []
                },
                {
                    "file": "AccessControlTableDriven.php",
                    "namespace": "Acme\\Security\\Access",
                    "class": "AccessControlTableDriven",
                    "scaffold": "method_beta",
                    "group": "A",
                    "pristine": false,
                    "variant": "api_table_driven",
                    "transforms": [
                        {
                            "code": "API-05",
                            "variant": "api_table_driven"
                        }
                    ]
                }
            ],
            "distractors": [
                {
                    "file": "RoleHierarchyChecker.php",
                    "namespace": "Acme\\Security\\Auth",
                    "class": "RoleHierarchyChecker",
                    "source": "nearmiss_access",
                    "reason": "near-miss: same authorization domain vocabulary (user, resource, roles, grants) but computes hierarchical role inheritance — a different authorization model with role precedence logic, not a duplicate of authorize"
                },
                {
                    "file": "PayrollAccessLogger.php",
                    "namespace": "Acme\\Security\\Audit",
                    "class": "PayrollAccessLogger",
                    "source": "nearmiss_csv",
                    "reason": "near-miss: same authorization vocabulary but logs access attempts to payroll systems — a different concern (audit logging) not authorization decisions"
                }
            ],
            "cleans": [
                {
                    "file": "SessionValidator.php",
                    "namespace": "Acme\\Security\\Session",
                    "class": "SessionValidator",
                    "source": "clean_auth"
                }
            ]
        },
