            "clone_symbol": "computeTotals",
            "granularity": "method",
            "clone_type": "type-1",
            "normalized_by": ["whitespace", "comments"],
            "rng_seed": 110901,
            "notes": "CP-06: Many files (5 carriers + 3 distractors). Infrastructure gap: SetBuilder generates exactly 3 carriers per set by design. This set uses 3 carriers + 2 extra clean files as 5-file variant. True 5-carrier sets require SetBuilder enhancement to support >3 carriers.",
            "role_composition": {"carrier": 3, "distractor": 2, "clean": 2},
            "scoring": {"line_tolerance": 2, "member_jaccard_min": 0.9, "min_members_for_credit": 3},
            "detection_expectation": {"text_based": true, "token_based": true, "ast_based": true, "metric_based": false, "semantic": false},
            "carriers": [
                {"file": "InvoiceCalculatorA.php", "namespace": "Acme\\Billing\\CalcA", "class": "InvoiceCalculatorA", "scaffold": "method_alpha", "group": "A", "pristine": true, "transforms": []},
                {"file": "InvoiceCalculatorB.php", "namespace": "Acme\\Billing\\CalcB", "class": "InvoiceCalculatorB", "scaffold": "method_beta", "group": "A", "pristine": true, "transforms": []},
