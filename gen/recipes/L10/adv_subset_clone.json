{
    "level": 10,
    "level_name": "adversarial_edge_cases",
    "level_dir": "L10_adversarial_edge_cases",
    "family": "adv_subset_clone",
    "capability_probe": {
        "capability": "multi_cluster_reporting",
        "sub_capability": "subset_detection",
        "description": "Detects when one clone is a strict subset of another (Clone2 ⊂ Clone1) and reports both correctly rather than merging or dropping the subset"
    },
    "sets": [
        {
            "set_id": "L10-adv_subset_clone-001",
            "title": "Clone2 ⊂ Clone1 — strict subset relationship across multiple files",
            "description": "Two clone clusters: Clone1 (30-line method) and Clone2 (15-line, strictly a subset of Clone1's code). The subset appears in the same code region but is truncated. Tests whether detectors correctly report both clones separately rather than merging them or dropping the subset.",
            "seed": "invoice_totals",
            "mount": "method",
            "clone_symbol": "computeTotals",
            "granularity": "method",
            "clone_type": "type-2",
            "normalized_by": ["whitespace", "comments", "identifiers"],
            "rng_seed": 112001,
            "notes": "O Idea 9 / §12.7: The Inclusion Problem. Clone2 is a strict subset of Clone1 — Clone2's code region is literally contained within Clone1's code region. Detectors face a choice: report Clone1 only (missing the subset), report both as separate clones, or merge them incorrectly. Multi-cluster reporting is required to surface both.",
            "scoring": {"line_tolerance": 2, "member_jaccard_min": 0.6, "min_members_for_credit": 2},
            "detection_expectation": {"text_based": false, "token_based": true, "ast_based": true, "metric_based": false, "semantic": true},
            "carriers": [
                {"file": "InvoiceCalculatorA.php", "namespace": "Acme\\Billing\\CalcA", "class": "InvoiceCalculatorA", "scaffold": "method_alpha", "group": "A", "pristine": true, "transforms": [], "cluster": "Clone1-Full"},
                {"file": "InvoiceCalculatorB.php", "namespace": "Acme\\Billing\\CalcB", "class": "InvoiceCalculatorB", "scaffold": "method_beta", "group": "A", "pristine": false, "transforms": [{"code": "LT-01"}], "cluster": "Clone1-Full"},
                {"file": "InvoiceCalculatorC.php", "namespace": "Acme\\Billing\\CalcC", "class": "InvoiceCalculatorC", "scaffold": "method_gamma", "group": "A", "pristine": false, "transforms": [{"code": "LT-01"}, {"code": "CM-03"}], "cluster": "Clone1-Full"},
                {"file": "ReceiptTotalerA.php", "namespace": "Acme\\Billing\\ReceiptA", "class": "ReceiptTotalerA", "scaffold": "method_alpha", "group": "B", "pristine": false, "transforms": [{"code": "ST-07", "params": {"head_trim": 7, "tail_trim": 8}}], "cluster": "Clone2-Subset"},
                {"file": "ReceiptTotalerB.php", "namespace": "Acme\\Billing\\ReceiptB", "class": "ReceiptTotalerB", "scaffold": "method_beta", "group": "B", "pristine": false, "transforms": [{"code": "ST-07", "params": {"head_trim": 7, "tail_trim": 8}}, {"code": "LT-01"}], "cluster": "Clone2-Subset"},
                {"file": "ReceiptTotalerC.php", "namespace": "Acme\\Billing\\ReceiptC", "class": "ReceiptTotalerC", "scaffold": "method_gamma", "group": "B", "pristine": false, "transforms": [{"code": "ST-07", "params": {"head_trim": 7, "tail_trim": 8}}, {"code": "LT-01"}, {"code": "CM-03"}], "cluster": "Clone2-Subset"}
            ],
            "distractors": [
                {"file": "TrustScorer.php", "namespace": "Acme\\Billing\\Scoring", "class": "TrustScorer", "source": "nearmiss_invoice", "reason": "Near-miss: same invoice vocabulary but different computation logic - computes premium fee instead"}
            ],
            "cleans": [
                {"file": "InvoiceParser.php", "namespace": "Acme\\Billing\\Parsing", "class": "InvoiceParser", "source": "clean_billing"}
            ]
        },
