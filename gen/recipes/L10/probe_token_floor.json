            "normalized_by": ["whitespace", "comments"],
            "rng_seed": 112801,
            "notes": "K-28 token_floor: 001/008. Target: 30 tokens. Seed trimmed to exact token count. Binary-search grid over tool defaults (phpcpd 70t, jscpd 50t, PMD 100t). F-10 token-targeting mount trims/pads to exact count.",
            "capability_probe": {
                "capability": "threshold_floor",
