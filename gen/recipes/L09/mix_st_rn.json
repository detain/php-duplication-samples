            "set_id": "L09-mix_st_rn-001",
            "title": "Invoice totals with statement edit + rename interference",
            "description": "The same computeTotals method across three billing classes. All carriers apply RN-05 case_convention but with different conventions (snake vs camel). One carrier additionally applies ST-04 delete_stmt. Token-based detectors should still identify the clones after normalization.",
            "seed": "invoice_totals",
            "mount": "method",
            "clone_symbol": "computeTotals",
            "granularity": "method",
            "clone_type": "type-3",
            "normalized_by": ["whitespace", "comments", "identifiers", "case_convention", "literals"],
            "edit_budget": 15,
            "rng_seed": 109201,
            "notes": "Combines RN-05 (case_convention) across all carriers with ST-04 (delete_stmt) applied to carrier C. The delete removes a non-essential statement but the core logic remains. This tests whether token overlap detection survives rename + statement-level edits.",
            "scoring": {"line_tolerance": 2, "member_jaccard_min": 0.5, "min_members_for_credit": 2},
            "detection_expectation": {"text_based": false, "token_based": true, "ast_based": true, "metric_based": true, "semantic": true},
            "carriers": [
                {"file": "PristineInvoiceCalc.php", "namespace": "Acme\\Billing\\Pristine", "class": "PristineInvoiceCalc", "scaffold": "method_alpha", "group": "A", "pristine": false, "transforms": [{"code": "RN-05", "params": {"direction": "snake_to_camel"}}]},
                {"file": "SnakeCaseCalc.php", "namespace": "Acme\\Billing\\Snake", "class": "SnakeCaseCalc", "scaffold": "method_beta", "group": "A", "pristine": false, "transforms": [{"code": "RN-05", "params": {"direction": "camel_to_snake"}}]},
                {"file": "TrimmedCaseCalc.php", "namespace": "Acme\\Billing\\Trimmed", "class": "TrimmedCaseCalc", "scaffold": "method_gamma", "group": "A", "pristine": false, "transforms": [{"code": "RN-05", "params": {"direction": "camel_to_snake"}}, {"code": "ST-04", "params": {"count": 1}}]}
            ],
            "distractors": [
                {"file": "MarginSummarizer.php", "namespace": "Acme\\Billing\\Summary", "class": "MarginSummarizer", "source": "nearmiss_invoice", "reason": "near-miss: same invoice line-item vocabulary and foreach-over-items shape, but computes revenue/cost/margin instead of subtotal/tax/total"}
            ],
            "cleans": [
                {"file": "TaxRateRepository.php", "namespace": "Acme\\Billing\\Tax", "class": "TaxRateRepository", "source": "clean_billing"}
            ]
