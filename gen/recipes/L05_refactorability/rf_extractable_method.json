            "title": "Invoice line processing clones that CAN be extracted to a shared method",
            "description": "Three billing classes with identical processLineItem methods that differ only in literal values. These CAN be unified into a single extractMethodWithHoles pattern.",
            "seed": "invoice_totals",
            "mount": "method",
            "clone_symbol": "processLineItem",
            "granularity": "method",
            "clone_type": "type-1",
            "schema_version": 2,
            "rng_seed": 500101,
            "normalized_by": ["whitespace", "comments", "identifiers", "literals"],
            "detection_expectation": {"text_based": true, "token_based": true, "ast_based": true},
            "intended_refactoring": {
                "kind": "extract_method_with_holes",
                "unified_symbol": "processLineItem",
                "unified_signature": "processLineItem(item, config)",
                "holes": [
                    {"hole_id": "error_handling", "description": "Missing exception handling for invalid item"},
                    {"hole_id": "logging", "description": "No audit trail logging"}
                ],
                "collapses": [0, 1, 2],
                "advisability": "recommended"
            },
            "solution": "<?php\ndeclare(strict_types=1);\n\nnamespace Acme\\Billing\\Unified;\n\nclass LineItemProcessor\n{\n    public function processLineItem(array $item, array $config): array\n    {\n        $quantity = (int)($item['quantity'] ?? 0);\n        $unitPrice = (float)($item['unit_price'] ?? 0.0);\n        $taxRate = (float)($config['tax_rate'] ?? 0.0);\n        $subtotal = $quantity * $unitPrice;\n        $tax = $subtotal * $taxRate;\n        $total = $subtotal + $tax;\n        return [\n            'quantity' => $quantity,\n            'unit_price' => $unitPrice,\n            'subtotal' => $subtotal,\n            'tax' => $tax,\n            'total' => $total,\n        ];\n    }\n}\n",
            "carriers": [
                {"file": "StandardBilling.php", "namespace": "Acme\\Billing\\Standard", "class": "StandardBilling", "scaffold": "method_alpha", "group": "A", "pristine": false, "transforms": []},
                {"file": "PremiumBilling.php", "namespace": "Acme\\Billing\\Premium", "class": "PremiumBilling", "scaffold": "method_beta", "group": "A", "pristine": false, "transforms": []},
